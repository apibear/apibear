{
  "name": "apibear",
  "version": "0.1.0",
  "description": "Turn any OpenAPI 3.x spec into MCP tools: a stdio MCP server CLI and an environment-agnostic parser library.",
  "license": "MIT",
  "author": "API Bear <support@apibear.com>",
  "homepage": "https://apibear.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apibear/apibear.git"
  },
  "bugs": {
    "url": "https://github.com/apibear/apibear/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "apibear": "dist/cli.js",
    "apibear-mcp-runner": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "pretest": "npm run build",
    "typecheck": "tsc",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10",
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "openapi",
    "openapi3",
    "swagger",
    "claude",
    "claude-desktop",
    "cursor",
    "llm-tools",
    "agentic-ai"
  ]
}
